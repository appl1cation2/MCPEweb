+bool ScrollingPane::scrollWheel(int x, int y, int delta) {
+	if (delta == 0 || !bboxArea.isInside((float)x, (float)y))
+		return false;
+
+	adjustContentSize();
+	const float minimumY = Mth::Min(0.0f, (float)(size.h - adjustedContentSize.h));
+	if (minimumY == 0.0f)
+		return false;
+
+	stopDecelerationAnimation();
+	const float wheelStep = (float)itemBbox.h;
+	const float yOffset = Mth::Min(0.0f, Mth::Max(minimumY,
+		_contentOffset.y + delta * wheelStep));
+	setContentOffset(_contentOffset.x, yOffset);
+	vScroll.fading = 1;
+	return true;
+}
